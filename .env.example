PAWDESK_ENV=local

# Banco e fila
PAWDESK_MYSQL_DSN=mysql+aiomysql://pawdesk:pawdesk@mysql:3306/pawdesk
PAWDESK_ADK_SESSIONS_DSN=mysql+aiomysql://pawdesk:pawdesk@mysql:3306/pawdesk_adk
PAWDESK_REDIS_URL=redis://redis:6379/0

# Modelos (confirme os IDs vigentes na documentação de cada provedor)
# Opção padrão (Anthropic via LiteLlm):
PAWDESK_MODEL_ROUTER=anthropic/claude-haiku-4-5
PAWDESK_MODEL_SPECIALIST=anthropic/claude-sonnet-4-6
PAWDESK_MODEL_JUDGE=anthropic/claude-sonnet-4-6
# Alternativa OpenAI via LiteLlm: openai/gpt-4o-mini e openai/gpt-4o
# Alternativa Gemini nativo ADK: gemini-2.5-flash e gemini-2.5-pro
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Canal e Helpdesk (em dev local use console + fake)
PAWDESK_CHANNEL_MODE=console
PAWDESK_HELPDESK_MODE=fake
PAWDESK_ADK_SESSION_BACKEND=database

# WhatsApp Cloud API
PAWDESK_WHATSAPP_VERIFY_TOKEN=change-me
PAWDESK_WHATSAPP_APP_SECRET=change-me
PAWDESK_WHATSAPP_ACCESS_TOKEN=change-me
PAWDESK_WHATSAPP_PHONE_NUMBER_ID=
PAWDESK_WHATSAPP_API_VERSION=v21.0

# Segurança & Admin (troque em produção)
PAWDESK_PSEUDONYM_SECRET=dev-pseudonym-secret-change-in-prod
PAWDESK_PHONE_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PAWDESK_ADMIN_API_TOKEN=dev-admin-token
PAWDESK_HELPDESK_WEBHOOK_SECRET=dev-helpdesk-secret

# Políticas parametrizáveis (RN-04 a RN-09, RN-14, RN-18)
PAWDESK_REGRET_WINDOW_DAYS=7
PAWDESK_DEFECT_WINDOW_DAYS=30
PAWDESK_REFUND_APPROVAL_LIMIT=500.00
PAWDESK_LATE_ORDER_HANDOFF_BUSINESS_DAYS=3
PAWDESK_VET_CHANNEL_AVAILABLE=true
PAWDESK_ENABLE_SIMULATOR=true
